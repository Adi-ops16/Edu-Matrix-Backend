model Teacher {
    teacher_id            String    @id
    designation           String?
    degree                String?
    specialization        String?
    graduated_from        String?
    graduation_year       Int?
    date_of_birth         DateTime?
    gender                Gender?
    phone                 String?
    address               String?
    joining_year          Int?
    bio                   String?
    certificate           String?
    certificate_public_id String?

    user        User                @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    departments TeacherDepartment[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("teachers")
}
