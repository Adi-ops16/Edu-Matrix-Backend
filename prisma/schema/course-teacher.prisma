model CourseTeacher {
    id Int @id @default(autoincrement())

    teacher_id        String
    course_details_id Int

    teacher Teacher       @relation(fields: [teacher_id], references: [teacher_id], onUpdate: Cascade)
    course  CourseDetails @relation(fields: [course_details_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([course_details_id, teacher_id])
    @@map("course_teachers")
}
