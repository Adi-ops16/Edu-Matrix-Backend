model Course {
    id                String   @id @default(uuid())
    title             String
    code              String
    description       String?
    learning_outcomes String[]

    department_id String
    department    Department @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

    course_details CourseDetails[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([department_id, code])
    @@map("courses")
}

model CourseDetails {
    id         Int          @id @default(autoincrement())
    semester   String
    batch      String
    start_date DateTime?
    end_date   DateTime?
    status     CourseStatus @default(UPCOMING)
    price      Decimal      @default(0) @db.Decimal(12, 2)
    currency   String       @default("BDT") @db.Char(3)

    course_id String

    course Course @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

    teachers    CourseTeacher[]
    enrollments StudentEnrollment[]
    payments    Payment[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("course_details")
}
