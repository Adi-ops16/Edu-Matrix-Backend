<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Payment confirmed | Edu-Matrix</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: Arial, Helvetica, sans-serif; color: #172033;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f1f5f9; padding: 36px 14px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 600px; overflow: hidden; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px;">
                    <tr>
                        <td align="center" style="padding: 28px 24px; background-color: #0f766e;">
                            <img
                                src="cid:brand-logo"
                                alt="Edu-Matrix"
                                width="48"
                                height="48"
                                style="display: block; margin: 0 auto 12px; padding: 5px; background-color: #ffffff; border-radius: 12px;"
                            />
                            <div style="font-size: 24px; line-height: 1.3; font-weight: 700; letter-spacing: -0.4px; color: #ffffff;">
                                Edu-Matrix
                            </div>
                            <div style="margin-top: 5px; font-size: 13px; color: #ccfbf1;">
                                Education Management Platform
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 36px 32px 18px;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center" style="padding-bottom: 22px;">
                                        <div style="display: inline-block; padding: 8px 14px; background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 20px; color: #047857; font-size: 12px; line-height: 1.2; font-weight: 700; letter-spacing: 0.8px;">
                                            PAYMENT SUCCESSFUL
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <h1 style="margin: 0 0 12px; text-align: center; font-size: 25px; line-height: 1.3; color: #111827;">
                                You’re enrolled!
                            </h1>
                            <p style="margin: 0 0 26px; text-align: center; font-size: 15px; line-height: 1.7; color: #526071;">
                                Hello <strong style="color: #172033;"><%= name %></strong>, your payment has been received and your course enrollment is confirmed.
                            </p>

                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 24px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                                <tr>
                                    <td style="padding: 20px 22px 8px;">
                                        <div style="margin-bottom: 7px; font-size: 11px; line-height: 1.4; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #64748b;">
                                            Course
                                        </div>
                                        <div style="font-size: 18px; line-height: 1.45; font-weight: 700; color: #0f172a;">
                                            <%= courseTitle %>
                                        </div>
                                        <div style="padding: 5px 0 14px; font-size: 13px; line-height: 1.6; color: #64748b;">
                                            Batch <%= batch %> &nbsp;|&nbsp; Semester <%= semester %>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse;">
                                <tr>
                                    <td style="padding: 12px 0; border-bottom: 1px solid #edf1f5; font-size: 14px; color: #64748b;">Amount paid</td>
                                    <td align="right" style="padding: 12px 0; border-bottom: 1px solid #edf1f5; font-size: 16px; font-weight: 700; color: #0f766e;"><%= amount %></td>
                                </tr>
                                <tr>
                                    <td style="padding: 12px 0; border-bottom: 1px solid #edf1f5; font-size: 14px; color: #64748b;">Payment date</td>
                                    <td align="right" style="padding: 12px 0; border-bottom: 1px solid #edf1f5; font-size: 14px; color: #172033;"><%= paymentDate %></td>
                                </tr>
                                <tr>
                                    <td valign="top" style="padding: 12px 0; font-size: 14px; color: #64748b;">Transaction ID</td>
                                    <td align="right" style="max-width: 300px; padding: 12px 0; font-size: 12px; line-height: 1.6; color: #172033; word-break: break-all;"><%= transactionId %></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 32px 32px;">
                            <p style="margin: 0; padding: 15px 17px; background-color: #f0fdfa; border-left: 3px solid #0f766e; border-radius: 6px; font-size: 13px; line-height: 1.7; color: #475569;">
                                Keep this email for your records. You can view your course and payment details anytime from your Edu-Matrix account.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding: 20px 24px; background-color: #f8fafc; border-top: 1px solid #edf1f5;">
                            <p style="margin: 0; font-size: 12px; line-height: 1.7; color: #94a3b8;">
                                This is an automated receipt from Edu-Matrix. If you have questions about this payment, please contact your institution.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
