<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Registration code</title>
  </head>
  <body>
    <div class="container"> 
      <h2>Registration code</h2>
      <p>Hello <%= name %>, your code for email: <%= email %> is,</p>
      <div class="otp"><%= otp %></div>
      <p>This OTP will expire in <%= expirationMinutes %> minutes.</p>
    </div>
  </body>
</html>