<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Institution Application Update</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background-color: #f4f7fb; padding: 40px 16px;"
    >
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width: 600px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                        border: 1px solid #e5e7eb;
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            style="
                                padding: 28px 32px;
                                text-align: center;
                                background-color: #111827;
                            "
                        >
                            <h1 style="
                                margin: 0;
                                font-size: 26px;
                                line-height: 1.3;
                                color: #ffffff;
                                font-weight: 700;
                            ">
                                Edu-Matrix
                            </h1>

                            <p style="
                                margin: 6px 0 0;
                                font-size: 13px;
                                color: #d1d5db;
                            ">
                                Education Management Platform
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 36px 32px;">

                            <p style="
                                margin: 0 0 20px;
                                font-size: 16px;
                                line-height: 1.6;
                            ">
                                Hello <strong><%= name %></strong>,
                            </p>

                            <p style="
                                margin: 0 0 24px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                Your application to join
                                <strong><%= institutionName %></strong>
                                as a
                                <strong><%= role === "STUDENT" ? "Student" : "Teacher" %></strong>
                                has been reviewed by the institution administrator.
                            </p>


                            <% if (membershipStatus === "APPROVED") { %>

                                <!-- Approved -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                    style="
                                        background-color: #ecfdf5;
                                        border: 1px solid #a7f3d0;
                                        border-radius: 10px;
                                        margin-bottom: 24px;
                                    "
                                >
                                    <tr>
                                        <td style="padding: 24px; text-align: center;">

                                            <div style="
                                                font-size: 34px;
                                                line-height: 1;
                                                margin-bottom: 12px;
                                            ">
                                                ✓
                                            </div>

                                            <h2 style="
                                                margin: 0 0 8px;
                                                font-size: 21px;
                                                color: #047857;
                                            ">
                                                Application Approved
                                            </h2>

                                            <p style="
                                                margin: 0;
                                                font-size: 14px;
                                                line-height: 1.6;
                                                color: #065f46;
                                            ">
                                                Congratulations! Your application has been
                                                approved.
                                            </p>

                                        </td>
                                    </tr>
                                </table>

                                <p style="
                                    margin: 0 0 16px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #4b5563;
                                ">
                                    You are now officially a member of
                                    <strong><%= institutionName %></strong>.
                                    You can log in to Edu-Matrix and access the features
                                    available to your account.
                                </p>

                                <table
                                    role="presentation"
                                    width="100%"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                    style="
                                        background-color: #f9fafb;
                                        border-radius: 8px;
                                        margin-top: 24px;
                                        margin-bottom: 24px;
                                    "
                                >
                                    <tr>
                                        <td style="padding: 18px 20px;">

                                            <p style="
                                                margin: 0 0 8px;
                                                font-size: 13px;
                                                color: #6b7280;
                                            ">
                                                Account
                                            </p>

                                            <p style="
                                                margin: 0;
                                                font-size: 14px;
                                                color: #111827;
                                            ">
                                                <strong><%= email %></strong>
                                            </p>

                                            <p style="
                                                margin: 14px 0 8px;
                                                font-size: 13px;
                                                color: #6b7280;
                                            ">
                                                Membership
                                            </p>

                                            <p style="
                                                margin: 0;
                                                font-size: 14px;
                                                color: #111827;
                                            ">
                                                <strong>
                                                    <%= role === "STUDENT" ? "Student" : "Teacher" %>
                                                </strong>
                                            </p>

                                        </td>
                                    </tr>
                                </table>


                            <% } else if (membershipStatus === "DECLINED") { %>

                                <!-- Declined -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                    style="
                                        background-color: #fef2f2;
                                        border: 1px solid #fecaca;
                                        border-radius: 10px;
                                        margin-bottom: 24px;
                                    "
                                >
                                    <tr>
                                        <td style="padding: 24px; text-align: center;">

                                            <div style="
                                                font-size: 34px;
                                                line-height: 1;
                                                margin-bottom: 12px;
                                            ">
                                                !
                                            </div>

                                            <h2 style="
                                                margin: 0 0 8px;
                                                font-size: 21px;
                                                color: #b91c1c;
                                            ">
                                                Application Declined
                                            </h2>

                                            <p style="
                                                margin: 0;
                                                font-size: 14px;
                                                line-height: 1.6;
                                                color: #991b1b;
                                            ">
                                                Unfortunately, your application was not approved
                                                at this time.
                                            </p>

                                        </td>
                                    </tr>
                                </table>

                                <p style="
                                    margin: 0 0 16px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #4b5563;
                                ">
                                    If you believe this decision was made in error or you
                                    require additional information, please contact the
                                    institution administrator.
                                </p>

                            <% } %>


                            <!-- Closing -->
                            <p style="
                                margin: 28px 0 0;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                Thank you for using <strong>Edu-Matrix</strong>.
                            </p>

                            <p style="
                                margin: 6px 0 0;
                                font-size: 15px;
                                color: #4b5563;
                            ">
                                Best regards,<br />
                                <strong>Edu-Matrix Team</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="
                                padding: 22px 32px;
                                background-color: #f9fafb;
                                border-top: 1px solid #e5e7eb;
                                text-align: center;
                            "
                        >
                            <p style="
                                margin: 0 0 6px;
                                font-size: 12px;
                                line-height: 1.5;
                                color: #9ca3af;
                            ">
                                This is an automated email. Please do not reply directly
                                to this message.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                color: #9ca3af;
                            ">
                                &copy; <%= new Date().getFullYear() %> Edu-Matrix.
                                All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>